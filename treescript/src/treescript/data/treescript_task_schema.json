{
    "title": "Taskcluster treescript task minimal schema",
    "type": "object",
    "properties": {
        "dependencies": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string"
            }
        },
        "scopes": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
                "type": "string"
            }
        },
        "payload": {
            "type": "object",
            "properties": {
                "version_bump_info": {
                    "type": "object",
                    "properties": {
                        "next_version": {
                            "type": "string"
                        },
                        "files": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "required": [
                        "next_version",
                        "files"
                    ]
                },
                "create_branch_info": {
                    "type": "object",
                    "properties": {
                        "branch_name": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "branch_name"
                    ]
                },
                "branch": {
                    "type": "string"
                },
                "source_repo": {
                    "type": "string"
                },
                "dry_run": {
                    "type": "boolean"
                },
                "push": {
                    "type": "boolean"
                },
                "dontbuild": {
                    "type": "boolean"
                }
            }
        }
    },
    "required": [
        "scopes",
        "payload"
    ]
}
